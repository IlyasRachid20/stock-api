# Copy to .env and change the values. .env is ignored by Git.
POSTGRES_DB=stock_api
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me
APP_PORT=8080
# Signs login tokens: at least 32 random characters, e.g. from: openssl rand -base64 48
APP_JWT_SECRET=
# Password of the "admin" account created on first start (leave empty to get a generated one in the logs)
APP_ADMIN_PASSWORD=
